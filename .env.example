# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_ACCESS_CODE: Optional passcode for /api/admin/* experiment CRUD console.
ADMIN_ACCESS_CODE="MY_ADMIN_ACCESS_CODE"

# ML_BACKEND_URL: Python FastAPI + Scikit-learn ML microservice URL (expects GET /health, GET /model-info, POST /predict).
ML_BACKEND_URL="http://127.0.0.1:8001"

# ML_SERVICE_MODE: "python" proxies ml/service.py; "portable" runs the exported model
# in-process from server/ml/ (required on Vercel, whose Functions cannot fit scikit-learn).
# Defaults to "python" locally and "portable" when VERCEL=1.
ML_SERVICE_MODE="python"

# DATA_DIR: Writable directory for the SQLite file. Defaults to ./data locally and
# /tmp/flame-sense-data on Vercel (the deployment bundle is read-only).
DATA_DIR=""

# CORS_ORIGINS: Optional comma-separated list of allowed CORS origins.
CORS_ORIGINS=""

# DATALAB_SESSION_SECRET: Optional HMAC signing secret for Data Lab session tokens.
DATALAB_SESSION_SECRET=""


